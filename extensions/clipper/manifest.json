{
  "manifest_version": 3,
  "name": "发送到 Tibi",
  "short_name": "Tibi",
  "version": "0.1.0",
  "description": "把当前网页的网址发送到 Tibi 导入阅读。不读页面内容，不登录。",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "发送到 Tibi",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "发送到 Tibi" }
  }
}

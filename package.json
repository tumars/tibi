{
  "name": "tibi",
  "private": true,
  "version": "0.0.0",
  "description": "Tibi（缇比）：本地优先、AI 原生的英语阅读学习工具",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tibi/desktop dev",
    "core:dev": "pnpm --filter @tibi/core-node dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm -r build",
    "ecdict": "pnpm --filter @tibi/core-node ecdict",
    "clipper:zip": "node extensions/clipper/zip.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}

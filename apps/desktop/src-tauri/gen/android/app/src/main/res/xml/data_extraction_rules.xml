<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 起的云端备份与设备间迁移：同上，secrets.json 不带走 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="secrets.json" />
        <exclude domain="file" path="secrets.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="secrets.json" />
        <exclude domain="file" path="secrets.json" />
    </device-transfer>
</data-extraction-rules>

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能走的命令：只有系统能力（06 §7），业务数据全经 core_call 到 sidecar",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:event:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://x.com/Tumars" },
        { "url": "https://github.com/tumars" },
        { "url": "https://www.ferecord.com/" },
        { "url": "https://github.com/tumars/tibi/releases/latest" },
        { "url": "https://dl.ferecord.com/latest/*" },
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    },
    "deep-link:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://dl.ferecord.com/notice.json" },
        { "url": "https://raw.githubusercontent.com/tumars/tibi/main/notice.json" }
      ]
    }
  ]
}

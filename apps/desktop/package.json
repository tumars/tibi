{
  "name": "@tibi/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tibi 桌面端：Tauri 2 壳 + React 界面",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sidecar-dev.mjs && tauri dev",
    "web": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tauri": "tauri",
    "test": "vitest run --root ../.. apps/desktop/test",
    "sidecar:dev": "node scripts/sidecar-dev.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "bundle:prep": "node scripts/bundle-prep.mjs",
    "bundle": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:sync": "node scripts/i18n-check.mjs --write",
    "webapp": "node scripts/web-dict.mjs && vite --port 1420 --strictPort --open /web.html",
    "build:webapp": "node scripts/build-webapp.mjs",
    "mobile:preview": "tauri dev --features mobile-preview --config src-tauri/tauri.mobile.conf.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.66.0",
    "mammoth": "1.9.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.9.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.3",
    "streamdown": "^2.7.1",
    "tesseract.js": "5.1.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@tibi/core": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
